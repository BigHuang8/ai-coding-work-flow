#!/usr/bin/env sh
# 提交前校验：文档规范自检 + 项目统一校验命令
# 原则：本地检查应在 60 秒内跑完，见 docs/10-技术栈适配.md

set -eu

HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
ROOT=$(git -C "$HOOK_DIR/.." rev-parse --show-toplevel)

echo "开始 pre-commit 校验..."

if [ -f "$ROOT/scripts/check-docs.mjs" ]; then
  command -v node >/dev/null 2>&1 || {
    echo "错误：未找到 node，请先安装 Node.js（>= 18）。" >&2
    exit 1
  }
  if ! (cd "$ROOT" && node scripts/check-docs.mjs); then
    cat >&2 <<'EOF'

文档与规范自检未通过，提交已阻止。按问题类型处理：
  1. 密钥或口令入库：必须改掉，这类问题不支持豁免；
  2. 历史文档的主语言或命名：把路径登记到 workflow.config.json 的 legacyDocs；
  3. 相对链接失效：修链接，或确认目标文件是否该入库；
  4. 模板必需文件缺失：从模板仓库同步，见 docs/08-接入清单.md。
处理方式详见 docs/09-常见问题.md。
EOF
    exit 1
  fi
else
  echo "提示：未找到 scripts/check-docs.mjs，已跳过文档自检。" >&2
fi

if [ -f "$ROOT/scripts/check-skills.mjs" ]; then
  (cd "$ROOT" && node scripts/check-skills.mjs)
fi

if [ -f "$ROOT/package.json" ]; then
  if command -v npm >/dev/null 2>&1; then
    if command -v bash >/dev/null 2>&1; then
      echo "运行项目校验命令：npm run validate --if-present"
      (cd "$ROOT" && npm run validate --if-present)
    else
      # 精简版 Git（MinGit 等）只有 sh 没有 bash，npm 在这种 shell 下执行 scripts 会失败
      echo "提示：当前环境没有 bash，npm 无法执行 scripts，改为直接运行 node 脚本。" >&2
      if [ -f "$ROOT/scripts/check-docs.mjs" ]; then
        (cd "$ROOT" && node scripts/check-docs.mjs && node scripts/check-skills.mjs && node scripts/detect-stack.mjs --check && node scripts/sync-platform.mjs --check)
      fi
    fi
  else
    echo "提示：未找到 npm，已跳过项目校验。" >&2
  fi
fi

echo "pre-commit 校验通过。"
