#!/usr/bin/env sh
# 提交信息格式校验：type(scope): subject
# 规则见 docs/05-分支提交与评审.md

set -eu

MESSAGE_FILE=${1:?缺少提交信息文件}
SUBJECT=$(head -n 1 "$MESSAGE_FILE")

case "$SUBJECT" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'

if ! printf '%s' "$SUBJECT" | grep -Eq "$PATTERN"; then
  cat >&2 <<'EOF'
提交信息格式错误，应为：type(scope): subject

示例：
  feat(customer): 客户列表支持按团队筛选
  fix(auth): 令牌过期后未跳转登录页
  docs(workflow): 补充证据留档的目录规范

允许类型：feat fix docs style refactor perf test build ci chore revert
说明见 docs/05-分支提交与评审.md
EOF
  exit 1
fi
