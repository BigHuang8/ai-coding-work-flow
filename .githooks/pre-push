#!/usr/bin/env sh
# 推送前校验：多 AI 工具配置同步 + 项目统一校验命令
# 跨模块与完整构建类检查应放在这里，见 docs/10-技术栈适配.md

set -eu

HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
ROOT=$(git -C "$HOOK_DIR/.." rev-parse --show-toplevel)

echo "开始 pre-push 校验..."

command -v node >/dev/null 2>&1 || {
  echo "错误：未找到 node，请先安装 Node.js（>= 18）。" >&2
  exit 1
}

if [ -f "$ROOT/scripts/sync-agent-config.mjs" ]; then
  if ! (cd "$ROOT" && node scripts/sync-agent-config.mjs --check); then
    cat >&2 <<'EOF'

AI 工具入口未同步，推送已阻止。处理方式：
  1. 改了 AGENTS.md 或引入/移除技能后，跑 node scripts/sync-agent-config.mjs 重新生成入口文件；
  2. 引入外部技能时跑 node scripts/sync-agent-config.mjs --lock 刷新哈希；
  3. 详见 docs/03-技能体系.md 与 docs/04-上下文与记忆治理.md。
EOF
    exit 1
  fi
fi

if [ -f "$ROOT/package.json" ] && command -v npm >/dev/null 2>&1; then
  if command -v bash >/dev/null 2>&1; then
    (cd "$ROOT" && npm run validate --if-present)
  else
    # 精简版 Git（MinGit 等）只有 sh 没有 bash，npm 在这种 shell 下执行 scripts 会失败
    echo "提示：当前环境没有 bash，npm 无法执行 scripts，改为直接运行 node 脚本。" >&2
    if [ -f "$ROOT/scripts/check-docs.mjs" ]; then
      (cd "$ROOT" && node scripts/check-docs.mjs && node scripts/detect-stack.mjs --check && node scripts/sync-platform.mjs --check)
    fi
  fi
fi

echo "pre-push 校验通过。"
