#!/usr/bin/env sh
# 推送前校验：多 AI 工具配置同步 + 项目统一校验命令
# 跨模块与完整构建类检查应放在这里，见 docs/10-技术栈适配.md

set -eu

HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
ROOT=$(git -C "$HOOK_DIR/.." rev-parse --show-toplevel)

echo "开始 pre-push 校验..."

command -v node >/dev/null 2>&1 || {
  echo "错误：未找到 node，请先安装 Node.js（>= 18）。" >&2
  exit 1
}

if [ -f "$ROOT/scripts/sync-agent-config.mjs" ]; then
  (cd "$ROOT" && node scripts/sync-agent-config.mjs --check)
fi

if [ -f "$ROOT/package.json" ] && command -v npm >/dev/null 2>&1; then
  (cd "$ROOT" && npm run validate --if-present)
fi

echo "pre-push 校验通过。"
