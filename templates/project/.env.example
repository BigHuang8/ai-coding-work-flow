# 环境变量示例
# 复制为 .env 后填入真实值；.env 不进入版本库
# 本文件只允许出现占位符，禁止写入任何真实口令或密钥

# ==================== 数据库 ====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=app
DB_USER=app_user
DB_PASSWORD=change-me

# ==================== 缓存 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== 服务端口 ====================
SERVER_PORT=8080
WEB_PORT=5173

# ==================== 第三方接口 ====================
# 密钥向维护者索取，不要写进任何被提交的文件
THIRD_PARTY_BASE_URL=https://example.invalid/api
THIRD_PARTY_KEY=your-api-key-here

# ==================== 日志 ====================
LOG_LEVEL=info
